        "\n",
        "# ── PASO 3 ──────────────────────────────────────────────────────────────\n",
        "def _num(t):\n",
        "    t = str(t).strip().upper().replace(\"USD\", \"\").replace(\"$\", \"\").replace(\" \", \"\")\n",
        "    mult = {\"B\": 1e9, \"M\": 1e6, \"K\": 1e3}.get(t[-1:], 1) if t else 1\n",
        "    t = t.rstrip(\"BMK\")\n",
        "    if \",\" in t and \".\" in t:\n",
        "        t = t.replace(\".\", \"\").replace(\",\", \".\") if t.rfind(\",\") > t.rfind(\".\") else t.replace(\",\", \"\")\n",
        "    elif \",\" in t:\n",
        "        t = t.replace(\",\", \"\") if len(t.split(\",\")[-1]) == 3 else t.replace(\",\", \".\")\n",
        "    try:\n",
        "        return float(t) * mult\n",
        "    except ValueError:\n",
        "        return None\n",
        "\n",
        "def paso3a():\n",

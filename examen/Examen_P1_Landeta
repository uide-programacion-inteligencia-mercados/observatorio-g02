        "        donde = f\"la fila donde grupo = {x.grupo} y momento = {x.momento}; mira la columna valor\"\n",
        "    OBS[\"p3\"] = {\"dato\": dato, \"tabla\": round(float(x.valor), 2), \"enlace\": enlace}\n",
        "    print(f\"EL DATO QUE VAS A COMPROBAR:  {dato}\")\n",

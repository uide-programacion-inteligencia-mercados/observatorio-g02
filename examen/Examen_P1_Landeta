        "        dato, enlace = f\"{x.grupo} · precio en Tía hoy\", x.url\n",
        "        donde = \"el precio grande que está junto a la foto del producto\"\n",
        "    elif caso[\"fuente\"] == \"bm\":\n",
        "        x = d[d.grupo == \"Ecuador\"].sort_values(\"momento\").iloc[-1]\n",
        "        v = caso[\"valores\"]\n",

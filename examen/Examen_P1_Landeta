        "        donde = f\"pasa el mouse sobre la línea de Ecuador en el año {x.momento}; aparece el valor (si dice 7.73B o 6.2K, escríbelo tal cual)\"\n",
        "    else:\n",
        "        x = d[d.momento == d.momento.max()].sort_values(\"grupo\").iloc[0]\n",

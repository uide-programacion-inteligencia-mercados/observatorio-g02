        "        filas.append({\"grupo\": nombre, \"momento\": \"Precio del cliente\", \"valor\": precio_cliente, \"fuente\": \"Cliente [SIMULADO]\", \"url\": url})\n",
        "        filas.append({\"grupo\": nombre, \"momento\": \"Precio en Tía hoy\", \"valor\": precio, \"fuente\": origen, \"url\": url})\n",

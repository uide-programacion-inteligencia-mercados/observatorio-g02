        "\n",
        "def _precio(html):\n",
        "    for patron in (r'product:price:amount\" content=\"([\\d.]+)\"', r'data-price-amount=\"([\\d.]+)\"', r'\"price\"\\s*:\\s*\"?([\\d.]+)'):\n",
        "        m = re.search(patron, html)\n",
